<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include Spring Boot's default configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Define log directory property -->
    <property name="LOG_DIR" value="${LOG_DIR:-/var/log/rule_engine}"/>
    <property name="MAX_FILE_SIZE" value="10MB"/>
    <property name="MAX_HISTORY" value="7"/>
    <property name="TOTAL_SIZE_CAP" value="1GB"/>

    <!-- Log pattern with traceId support -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread{15}] %-5level %logger{15} [%X{traceId:-}] - %msg%n"/>

    <!-- Console appender for all environments -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Spring startup log (catalina.log) - current day has no date suffix -->
    <appender name="CATALINA_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/catalina.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/catalina.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Business application log (app.log) - current day has no date suffix -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Error log (error.log) - only ERROR level, current day has no date suffix -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Spring framework logs (startup, initialization, warmup) -->
    <logger name="org.springframework" level="INFO" additivity="false">
        <appender-ref ref="CATALINA_FILE"/>
    </logger>

    <logger name="org.springframework.boot" level="INFO" additivity="false">
        <appender-ref ref="CATALINA_FILE"/>
    </logger>

    <logger name="org.springframework.context" level="INFO" additivity="false">
        <appender-ref ref="CATALINA_FILE"/>
    </logger>

    <!-- Development environment configuration -->
    <springProfile name="dev">
        <logger name="lab.zhang.rule" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="APP_FILE"/>
        </logger>
        <!-- Database operation logs -->
        <logger name="com.baomidou.mybatisplus" level="INFO"/>
        <logger name="org.springframework.jdbc" level="DEBUG"/>
        <logger name="org.springframework.data.redis" level="DEBUG"/>
    </springProfile>

    <!-- Test environment configuration -->
    <springProfile name="test">
        <logger name="lab.zhang.rule" level="INFO" additivity="false">
            <appender-ref ref="APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        <!-- Database operation logs -->
        <logger name="com.baomidou.mybatisplus" level="WARN"/>
        <logger name="org.springframework.jdbc" level="WARN"/>
        <logger name="org.springframework.data.redis" level="WARN"/>
    </springProfile>

    <!-- Gray environment configuration -->
    <springProfile name="gray">
        <logger name="lab.zhang.rule" level="INFO" additivity="false">
            <appender-ref ref="APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        <!-- Database operation logs -->
        <logger name="com.baomidou.mybatisplus" level="WARN"/>
        <logger name="org.springframework.jdbc" level="WARN"/>
        <logger name="org.springframework.data.redis" level="WARN"/>
    </springProfile>

    <!-- Production environment configuration -->
    <springProfile name="prod">
        <logger name="lab.zhang.rule" level="INFO" additivity="false">
            <appender-ref ref="APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        <!-- Database operation logs -->
        <logger name="com.baomidou.mybatisplus" level="WARN"/>
        <logger name="org.springframework.jdbc" level="WARN"/>
        <logger name="org.springframework.data.redis" level="WARN"/>
    </springProfile>

    <!-- Root logger configuration - includes all appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="CATALINA_FILE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
